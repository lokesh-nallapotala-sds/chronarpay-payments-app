<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Invoice Payment Dashboard</masterLabel>
    <description>A premium dashboard for viewing invoices and processing payments using Salesforce Payments features.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default,lightning__AppPage,lightning__RecordPage,lightning__HomePage">
            <property name="paymentGatewayId" type="String" label="Payment Gateway ID" description="The Salesforce ID of the Payment Gateway to use for transactions."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>